# Copy this file to .env and replace the placeholder.
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter alternative (preferred when you use an OpenRouter key):
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openrouter/auto

# Optional: only set this when using an OpenAI-compatible provider instead of
# api.openai.com. Include its complete /v1 URL, for example:
# OPENAI_BASE_URL=https://provider.example/v1

# Optional overrides
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:///./field_agent.db
APP_SECRET_KEY=replace-with-a-long-random-production-secret

# Production example (start docker-compose.yml first):
# DATABASE_URL=postgresql+psycopg://hvac:hvac_dev_password@localhost:5432/hvac_agent

# Retrieval controls
RETRIEVAL_BACKEND=auto
RERANK_ENABLED=true
